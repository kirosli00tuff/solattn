# solattn environment template
# Copy to .env and fill in. NEVER commit .env — it is gitignored, and
# tests/test_honesty.py scans every tracked file for credential-shaped strings
# so a leak breaks the build rather than shipping.
#
# Every variable is listed here with NO VALUE, on purpose. An empty or
# whitespace-only value is treated as ABSENT by solattn/config.py, which raises
# MissingSecretError naming the variable rather than proceeding with a blank
# credential. Copying this file without filling it in fails loudly.
#
# No credential in this project has any capability beyond reading public data.
# There is no venue credential, no trading key, and no signer anywhere in this
# repository or in any planned stage.

# --- Telegram MTProto (public channel reads only) ---------------------------
# Created by the operator at https://my.telegram.org -> API development tools.
# api_id is an integer; api_hash is a 32-character hex string.
# Absent credentials are NOT fatal: the Telegram collector reports exactly what
# is missing and stays inactive while every other source keeps collecting.
SOLATTN_TELEGRAM_API_ID=
SOLATTN_TELEGRAM_API_HASH=

# Telethon session name. The session FILE it creates is gitignored (*.session).
# A session is produced by a one-time interactive login (phone + code) that
# only the operator can perform; MTProto has no non-interactive user login.
SOLATTN_TELEGRAM_SESSION=solattn

# --- Keyless sources --------------------------------------------------------
# GeckoTerminal (new-pools feed + OHLCV), Bluesky Jetstream, and the Farcaster
# hub are all keyless. They are listed here only to record that no key exists
# for them, so a future reader does not go looking for one.
#
# Self-imposed daily request caps for the gate (ADR-003). Defaults live in
# solattn/registry.py; raising one is a deliberate decision made before a run,
# never mid-run.
# SOLATTN_GECKOTERMINAL_DAILY_CAP=10000
# SOLATTN_BLUESKY_DAILY_CAP=200
# SOLATTN_FARCASTER_DAILY_CAP=20000

# Root for collected data. Defaults to ./data
# SOLATTN_DATA_ROOT=data
